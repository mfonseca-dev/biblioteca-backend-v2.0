{
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/agente/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/totem",
      "destination": "/totem.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/totem",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/acessos?acao=reset-diario",
      "schedule": "45 22 * * *"
    },
    {
      "path": "/api/acessos?acao=processar-garantias",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/pagamentos?acao=processar-prazos-expirados",
      "schedule": "50 22 * * *"
    }
  ]
}